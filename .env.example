# ====================================================================
# BERTUMBUH AGENCY ERP - ENVIRONMENT TEMPLATE (.env.example)
# ====================================================================

# APP CONFIGURATION
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME="Bertumbuh ERP"
NEXT_PUBLIC_AGENCY_NAME="PT Bertumbuh Creative Agency"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# KREDENSIAL AKUN INTERNAL PER ROLE
# --------------------------------------------------------------------

# OWNER / DIREKTUR
NEXT_PUBLIC_ROLE_OWNER_EMAIL=owner@bertumbuh.id
NEXT_PUBLIC_ROLE_OWNER_PASSWORD=demo123

# SUPER ADMIN / ADMIN OPERASIONAL
NEXT_PUBLIC_ROLE_SUPER_ADMIN_EMAIL=admin@bertumbuh.id
NEXT_PUBLIC_ROLE_SUPER_ADMIN_PASSWORD=demo123

# PROJECT MANAGER (PM)
NEXT_PUBLIC_ROLE_PM_EMAIL=pm@bertumbuh.id
NEXT_PUBLIC_ROLE_PM_PASSWORD=demo123

# FINANCE MANAGER
NEXT_PUBLIC_ROLE_FINANCE_EMAIL=finance@bertumbuh.id
NEXT_PUBLIC_ROLE_FINANCE_PASSWORD=demo123

# ACCOUNT EXECUTIVE (AE / CRM)
NEXT_PUBLIC_ROLE_AE_EMAIL=ae@bertumbuh.id
NEXT_PUBLIC_ROLE_AE_PASSWORD=demo123

# HR MANAGER
NEXT_PUBLIC_ROLE_HR_EMAIL=hr@bertumbuh.id
NEXT_PUBLIC_ROLE_HR_PASSWORD=demo123

# ANGGOTA TIM / KARYAWAN
NEXT_PUBLIC_ROLE_MEMBER_EMAIL=team@bertumbuh.id
NEXT_PUBLIC_ROLE_MEMBER_PASSWORD=demo123

# --------------------------------------------------------------------
# KONFIGURASI BACKEND DATABASE (SUPABASE)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
